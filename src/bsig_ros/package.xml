<?xml version="1.0"?>
<package format="3">
  <name>bsig_ros</name>
  <version>0.1.0</version>
  <description>Behavioral Signals streaming API bridge for ROS 2</description>
  <maintainer email="api-support@behavioralsignals.com">Behavioral Signals</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/BehavioralSignalTechnologies/behavioralsignals-ros2</url>
  <url type="bugtracker">https://github.com/BehavioralSignalTechnologies/behavioralsignals-ros2/issues</url>

  <depend>rclpy</depend>
  <depend>audio_common_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>bsig_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-grpcio</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
